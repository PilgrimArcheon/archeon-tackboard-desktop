{
  "name": "tackboard-desktop",
  "private": true,
  "version": "0.6.0",
  "description": "TackBoard wallpaper-visible floating sticky notes for Windows and macOS",
  "main": "src/main.cjs",
  "author": "Archeon",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "pack:win": "electron-builder --win dir --x64",
    "pack:mac": "electron-builder --mac dir",
    "verify:release": "node scripts/release-preflight.cjs"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.archeon.tackboard",
    "productName": "TackBoard",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.cjs",
      "src/preload.cjs",
      "src/core.cjs",
      "src/reconcile.cjs",
      "src/geometry.cjs",
      "src/sizes.cjs",
      "src/hub.*",
      "src/sticky.*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSHighResolutionCapable": true
      },
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "title": "Install TackBoard",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
